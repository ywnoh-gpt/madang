lse);$('diagnosticChecks').replaceChildren();(report.checks||[]).forEach(check=>{const item=document.createElement('li');if(typeof check==='string')item.textContent=check;else item.textContent=(check.ok===true||check.passed===true?'통과 · ':check.ok===false||check.passed===false?'확인 필요 · ':'미실행 · ')+(check.label||check.name||check.field||'항목')+(check.message?' · '+check.message:'');$('diagnosticChecks').append(item);});if(report.safeDetail){const item=document.createElement('li');item.textContent='Google 예외 상세 (키·주소 숨김): '+report.safeDetail;$('diagnosticChecks').append(item);}}\n    async function diagnosticCall(method){if(state.busy)return;setBusy(true);message('diagnosticMessage',method==='verifyRegisteredKey'?'[실제 API] 등록된 키로 연결·PDF·시트 쓰기를 확인하고 있습니다.':method==='runSampleCheck'?'[실제 API] 합성 PDF를 보내 인식 결과를 확인하고 있습니다.':'점검 중입니다.');try{renderDiagnostic(await rpc(method));}catch(error){message('diagnosticMessage',error.message,true);}finally{setBusy(false);}}\n    $('apiKeyForm').addEventListener('submit',async event=>{event.preventDefault();if(state.busy)return;const key=$('apiKeyInput').value.trim();if(!key)return;setBusy(true);try{const report=await rpc('saveApiKey',key);renderDiagnostic({...report,message:'키를 저장했습니다. API 연결 점검으로 실제 사용 가능 여부를 확인하세요.'});await loadState(true);}catch(error){message('diagnosticMessage',error.message,true);}finally{$('apiKeyInput').value='';setBusy(false);}});\n    $('verifyRegisteredKey').addEventListener('click',()=>diagnosticCall('verifyRegisteredKey'));\n    $('copyVerification').addEventListener('click',async()=>{if(!state.verification)return;const report=JSON.stringify(state.verification,null,2);try{await navigator.clipboard.writeText(report);message('diagnosticMessage','키를 제외한 진단 결과를 복사했습니다.');}catch(error){const output=document.createElement('textarea');output.value=report;output.readOnly=true;output.setAttribute('aria-label','키를 제외한 진단 결과');$('diagnosticChecks').replaceChildren(output);output.focus();output.select();message('diag