# Public Supabase project URL and publishable/anon key (RLS must be installed first).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# The server reuses the public pair above; no duplicate Supabase settings needed.
# Server-only secret in Vercel; NEVER prefix Gemini keys with VITE_.
GEMINI_API_KEY=
# Optional model override:
GEMINI_MODEL=gemini-flash-lite-latest
