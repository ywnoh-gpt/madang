|{};state.confidence=data.confidence||{};fillForm({...personal,...data.fields,forecastDate:personal.forecastDate||today()});$('reviewed').checked=false;$('beforeResult').checked=false;$('reviewTag').textContent='원본과 대조해 주세요';$('warningsList').replaceChildren();(data.warnings||[]).forEach(w=>{const li=document.createElement('li');li.textContent=String(w);$('warningsList').append(li);});$('extractionWarnings').hidden=!(data.warnings||[]).length;message('sourceMessage','인식 완료. 금액·날짜·사건번호를 원본 자료와 확인해 주세요.');}catch(error){message('sourceMessage',error.message,true);}finally{setBusy(false);}});\n    $('journalForm').addEventListener('submit',async e=>{e.preventDefault();if(state.busy||state.saved)return;if(!state.app?.configured){message('saveMessage','먼저 기록장 시트를 준비해 주세요.',true);return;}if(!$('reviewed').checked)return;if($('archiveDocuments').checked&&!state.documents.length){message('saveMessage','원본을 보관하려면 이미지나 PDF를 먼저 올려 주세요.',true);return;}setBusy(true);message('saveMessage','확인한 내용을 저장하고 있습니다.');try{const result=await rpc('saveReviewedRecord',{fields:inputValues(),reviewed:$('reviewed').checked,beforeResultConfirmed:$('beforeResult').checked,draftId:state.draftId,documents:documentsPayload(),archiveDocuments:$('archiveDocuments').checked,resultVisibilityCorrected:$('resultVisibilityCorrected').checked,correctionReason:$('correctionReason').value.trim()});state.saved=true;$('newRecordButton').hidden=false;message('saveMessage','시트에 저장했습니다. 원본 예측과 검토 이력이 보존됩니다.'+(result.warning?' '+result.warning:''));await loadState(true);}catch(error){if(error.message.includes('기록은 저장되었지만')){state.saved=true;$('newRecordButton').hidden=false;await loadState(true);}message('saveMessage',error.message,true);}finally{setBusy(false);}});\n    function openResult(rec){state.selectedRecord=rec;$('resultProperty').textContent=rec.court+' · '+rec.caseNumber+' · '+rec.auctionDate;updateSpecs.forEach(([key])=>$('update_'+key).value=rec[key]??(key==='saleResult'?'미확인':''));$('resultComparisons