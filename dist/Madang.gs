n-top:4px;accent-color:var(--ink)}.save-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:17px}.save-footer small{font-size:10px;color:var(--muted)}.message{font-size:12px;line-height:1.7;margin:12px 0 0;word-break:break-word}.message.error{color:var(--danger)}.message.success{color:#3d7131}.records{margin-top:28px}.records-heading{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:14px}.records-heading h2{font-size:18px;margin:0}.records-heading small{font-size:11px;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.metric{background:white;border:1px solid var(--line);border-radius:12px;padding:17px 20px}.metric span{font-size:11px;color:var(--muted);display:block}.metric strong{display:block;font-size:23px;margin-top:4px;font-weight:600;letter-spacing:-.6px}.table-wrap{overflow:auto;border-radius:12px;border:1px solid var(--line);background:white}table{border-collapse:collapse;width:100%;white-space:nowrap;font-size:12px}th{text-align:left;background:#eff3eb;font-size:10px;color:var(--muted);font-weight:600;padding:12px 16px}td{padding:14px 16px;border-top:1px solid #edf1e9}td small{display:block;font-size:10px;color:var(--muted)}.empty{text-align:center;padding:40px;color:var(--muted)}.positive{color:var(--warning)}.negative{color:#3c7594}.table-note{font-size:10px;color:var(--muted);margin-top:9px}.footer{margin-top:28px;color:#8c9b91;font-size:10px}.busy-indicator{display:inline-block;width:12px;height:12px;border:2px solid #c0d3b4;border-top-color:var(--ink);border-radius:50%;animation:spin .8s linear infinite;margin-right:7px;vertical-align:middle}@keyframes spin{to{transform:rotate(360deg)}}dialog{border:1px solid var(--line);border-radius:16px;padding:25px;width:min(540px,95vw);color:var(--text)}dialog::backdrop{background:#17362ac2}dialog h2{font-size:18px;margin:0 0 15px}dialog .actions{display:flex;justify-content:end;gap:8px;margin-top:18px}dialog.image-dialog{width:95vw;max-width:1400px;max-height:95vh;overflow:auto;padding:12px}dialog.image-dialog img{width:100%;display:block}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}.warnings-list{margin:6px 0;padding-left:18px}#recordForm{border:0;padding:0;margin:0;min-width:0}\n    .document-list{display:grid;gap:9px;margin:14px 0}.document-item{padding:10px;border:1px solid var(--line);border-radius:9px;background:#fafcf8}.document-item.active{border-color:#7f9e6b;background:#f3f8ea}.document-top{display:flex;align-items:start;gap:8px}.document-name{min-width:0;flex:1;text-align:left;border:0;background:none;color:var(--ink);font-size:11px;padding:0;overflow-wrap:anywhere}.document-name strong{display:block}.document-name small{color:var(--muted);font-size:10px}.document-remove{font-size:11px;color:var(--danger);border:0;background:none;padding:0}.document-type{width:100%;border:1px solid var(--line);border-radius:5px;padding:4px 7px;margin-top:7px;font-size:10px;background:white;color:var(--text)}.pdf-preview{background:#f1f4ec;border-radius:10px;padding:24px 15px;text-align:center}.pdf-preview>span{display:block;color:#6a8060;font-size:24px;font-weight:700;letter-spacing:2px}.pdf-preview strong{display:block;font-size:12px;overflow-wrap:anywhere;margin:8px 0 14px}.pdf-preview p{font-size:10px;margin-top:12px}.document-guide{padding-left:17px;color:var(--muted)}.document-guide li{margin:8px 0}\n    @media(max-width:900px){.shell{padding:0 20px 30px}.workspace{grid-template-columns:minmax(240px,.8fr) minmax(360px,1fr)}.brand small{display:none}.steps{display:none}.intro{padding-top:25px}h1{font-size:26px}.card-body{padding:17px}.metrics{grid-template-columns:repeat(2,1fr)}}\n    @media(max-width:650px){.workspace{grid-template-columns:1fr}.shell{padding:0 15px 30px}.topbar{min-height:64px}.brand strong{font-size:18px}.top-actions{gap:6px}.connection{font-size:10px}.top-actions .button{font-size:10px;padding:7px 9px}.intro{padding:22px 0 16px}h1{font-size:25px}.intro p{font-size:12px}.dropzone{min-height:160px}.card-head{padding:15px 17px}.metrics{gap:8px}.metric{padding:12px}.metric strong{font-size:21px}.records-heading h2{font-size:16px}}\n    @media(max-width:350px){.shell{padding:0 10px 25px}.brand{gap:8px}.logo{width:28px;height:28px;font-size:18px}.brand strong{font-size:16px}.top-actions .button{padding:6px}.connection{display:none}h1{font-size:22px}.field-grid{gap:9px}.card-body{padding:13px}.save-footer{flex-direction:column;align-items:stretch}.save-footer .button{width:100%}.metric span{font-size:10px}}\n    @media(prefers-reduced-motion:reduce){*{animation:none!important}}\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <header class=\"topbar\">\n      <div class=\"brand\"><div class=\"logo\" aria-hidden=\"true\">ㅁ</div><div><strong>마당</strong><small>모의 입찰 기록장</small></div></div>\n      <div class=\"top-actions\"><span id=\"connection\" class=\"connection\" role=\"status\">연결 확인 중</span><a id=\"sheetLink\" class=\"button\" target=\"_blank\" rel=\"noopener noreferrer\" hidden>시트 열기 ↗</a></div>\n    </header>\n    <section class=\"intro\">\n      <div><div class=\"eyebrow\">MY AUCTION JOURNAL</div><h1>캡처도 문서도,<br>판단은 내 기록으로.</h1><p>물건 정보는 AI와 함께 읽고, 입찰 판단은 직접 남기세요.</p></div>\n      <div class=\"steps\"><b>01</b> 자료 올리기 &nbsp;→&nbsp; <b>02</b> 확인·수정 &nbsp;→&nbsp; <b>03</b> 시트 저장</div>\n    </section>\n    <div id=\"setupNotice\" class=\"notice\" hidden><strong>기록할 시트를 준비해 주세요.</strong><p>이 스프레드시트에 ‘마당 기록’, ‘마당 성과’, ‘마당 변경 이력’ 전용 탭을 만듭니다. 기존 탭은 유지합니다.</p><button id=\"setupButton\" class=\"button primary\" type=\"button\">기록장 시트 준비</button></div>\n    <div id=\"keyNotice\" class=\"notice\" hidden><strong>AI 인식 연결이 필요합니다.</strong><p>스프레드시트 상단 ‘마당 기록장’ 메뉴에서 Gemini API 키를 설정하세요. 연결 전에도 수동으로 입력·저장할 수 있습니다.</p></div>\n    <main>\n      <div class=\"workspace\">\n        <section class=\"card source-card\" aria-labelledby=\"sourceTitle\">\n          <div class=\"card-head\"><h2 id=\"sourceTitle\">01 &nbsp; 물건 자료</h2><span class=\"tag\" id=\"imageTag\">원본부터 차근차근</span></div>\n          <div class=\"card-body\">\n            <input id=\"fileInput\" type=\"file\" accept=\"image/png,image/jpeg,image/webp,application/pdf\" multiple class=\"sr-only\" aria-label=\"물건 이미지 또는 PDF 문서 선택\">\n            <button id=\"dropzone\" class=\"dropzone wide\" style=\"width:100%\" type=\"button\"><span class=\"upload-symbol\" aria-hidden=\"true\">＋</span><strong>캡처나 PDF를 여기에 놓아 주세요</strong><p>클릭해서 선택하거나 Ctrl / ⌘ + V로 붙여넣기</p><small>이미지 5MB · PDF 8MB / 최대 3개, 합계 12MB</small></button>\n            <div id=\"documentList\" class=\"document-list\" aria-label=\"업로드한 자료 목록\"></div>\n            <div id=\"previewPanel\" hidden>\n              <button id=\"previewButton\" class=\"image-preview\" type=\"button\" style=\"width:100%;padding:0;border:0\" aria-label=\"원본 캡처 확대\"><img id=\"previewImage\" alt=\"선택한 경매 물건 캡처\"></button>\n              <div id=\"pdfPreview\" class=\"pdf-preview\" hidden><span aria-hidden=\"true\">PDF</span><strong id=\"pdfName\"></strong><a id=\"pdfLink\" class=\"button\" target=\"_blank\" rel=\"noopener noreferrer\">원본 PDF 열기 ↗</a><p>읽기 어려운 표와 문구는 원본에서 확인하세요.</p></div>\n              <div class=\"preview-caption\"><span id=\"fileName\"></span><button id=\"addDocuments\" class=\"text-button\" type=\"button\">자료 추가</button></div>\n            </div>\n            <div class=\"source-actions\"><button id=\"extractButton\" type=\"button\" class=\"button primary\" disabled>AI로 정보 읽기</button><button id=\"manualButton\" type=\"button\" class=\"button\">직접 입력</button></div>\n            <p class=\"hint\">‘AI로 정보 읽기’를 누르면 선택한 자료가 Google Gemini API로 전송됩니다. 불필요한 개인정보는 가려 주세요. AI는 자료의 사실만 읽고, 나의 입찰 금액은 작성하지 않습니다.</p>\n            <div id=\"sourceMessage\" class=\"message\" aria-live=\"polite\"></div>\n            <div id=\"extractionWarnings\" class=\"notice\" style=\"margin-top:15px\" hidden><strong>원본과 한 번 더 확인해 주세요</strong><ul id=\"warningsList\" class=\"warnings-list\"></ul></div>\n            <details id=\"connectionSetup\" class=\"setup\"><summary>연결 설정 · 점검</summary>\n              <p>최초 실행의 ‘Google에서 확인하지 않은 앱’은 본인이 만든 프로젝트임을 확인한 뒤 <b>고급 → 프로젝트로 이동 → 허용</b>으로 승인합니다. API 키와 별도의 Google 계정 승인입니다.</p>\n              <p id=\"setupStatus\" role=\"status\">연결 상태를 확인해 주세요.</p>\n              <form id=\"apiKeyForm\" autocomplete=\"off\"><div class=\"field\"><label for=\"apiKeyInput\">Gemini API 키</label><input id=\"apiKeyInput\" type=\"password\" autocomplete=\"off\" spellcheck=\"false\" autocapitalize=\"none\" placeholder=\"새 키를 입력하세요\" required maxlength=\"300\"></div><p class=\"hint\">키는 Google 스크립트 속성에 저장하고 화면에서는 지웁니다. 키를 저장해도 실제 API 연결 성공을 뜻하지는 않습니다.</p><button id=\"storeApiKey\" type=\"submit\" class=\"button wide\">키 저장</button></form>\n              <div class=\"source-actions\"><button id=\"checkSetup\" type=\"button\" class=\"button\">설정 상태 확인</button><button id=\"checkApi\" type=\"button\" class=\"button\">API 연결 점검</button></div>\n              <div class=\"source-actions\"><button id=\"liveSample\" type=\"button\" class=\"button\">실제 PDF 인식 테스트</button><button id=\"simulatedCheck\" type=\"button\" class=\"button\">모의 점검</button></div>\n              <button id=\"verifyRegisteredKey\" type=\"button\" class=\"button primary wide\" style=\"margin-top:12px\">등록된 키로 실제 전체 점검</button>\n              <p class=\"hint\">현재 저장된 키로 API 연결·합성 PDF 인식·임시 시트 쓰기와 읽기를 확인합니다. 임시 시트는 점검 후 삭제하고 기존 기록은 유지합니다.</p>\n              <button id=\"copyVerification\" type=\"button\" class=\"text-button\" hidden>진단 결과 복사 (키 제외)</button>\n              <p class=\"hint\">실제 테스트는 합성 PDF를 Gemini로 보내며 API 사용량이 발생할 수 있습니다. 모의 점검은 API를 호출하지 않습니다. 두 점검 모두 물건 기록에 테스트 행을 추가하지 않습니다.</p>\n              <div id=\"diagnosticMessage\" class=\"message\" aria-live=\"polite\"></div><ul id=\"diagnosticChecks\" class=\"warnings-list\"></ul>\n              <p>최초 시트 준비 후에는 같은 물건의 자료를 읽고 확인·수정하여 저장하세요. 다음 매각기일은 새 회차로 추가합니다.</p>\n            </details>\n            <details class=\"setup\"><summary>어떤 문서를 올리면 좋을까요?</summary><ul class=\"document-guide\"><li><b>기본정보 화면 + 매각물건명세서</b>로 시작하세요. 사건번호·매각기일·최저가를 함께 확인하기 좋습니다.</li><li><b>감정평가서</b>는 감정가·면적의 근거, <b>현황조사서</b>는 점유 현황을 확인할 때 추가하세요.</li><li><b>등기부등본</b>은 등기 내용을 확인할 때 사용하세요. 주민등록번호 등 불필요한 개인정보는 가려 주세요.</li></ul><p>문서에 없는 가격·기일은 빈칸으로 남깁니다. HWP·Word는 PDF로 저장해 올리세요. 암호가 걸린 PDF는 해제 후 사용하세요. 서로 다른 물건·매각기일은 나누어 기록하고 권리관계는 원문으로 확인하세요.</p></details>\n          </div>\n        </section>\n        <section class=\"card review-card\" aria-labelledby=\"reviewTitle\">\n          <div class=\"card-head\"><h2 id=\"reviewTitle\">02 &nbsp; 확인하고 판단하기</h2><span class=\"tag\" id=\"reviewTag\">수동 입력 가능</span></div>\n          <div class=\"card-body\">\n            <form id=\"journalForm\">\n              <fieldset id=\"recordForm\">\n                <fieldset class=\"form-section\"><legend>자료에서 읽은 물건 정보</legend><div id=\"factFields\" class=\"field-grid\"></div></fieldset>\n                <fieldset class=\"form-section\"><legend>내 사전 예측</legend><p class=\"hint\" style=\"margin:-3px 0 12px\">결과를 확인하기 전에 기록하세요. 아래 금액은 자동으로 채우지 않습니다.</p><div id=\"forecastFields\" class=\"field-grid\"></div></fieldset>\n                <details class=\"disclosure\"><summary>비용과 목표 이익 · 상한가 계산</summary><div id=\"costFields\" class=\"field-grid\"></div><div class=\"limit\"><span>내 입찰 상한가</span><strong id=\"upperLimit\">—</strong></div></details>\n                <details class=\"disclosure\"><summary>추가 물건 정보 · 메모 링크</summary><div id=\"extraFields\" class=\"field-grid\"></div></details>\n                <details class=\"disclosure\"><summary>이미 확인된 매각 결과</summary><p class=\"hint\">결과를 알고 입력한 예측은 정확도 집계에서 제외하세요.</p><div id=\"resultFields\" class=\"field-grid\"></div></details>\n                <div class=\"field\"><label for=\"correctionReason\">인식값 수정 이유 (선택)</label><textarea id=\"correctionReason\" placeholder=\"예: 명세서의 면적을 원본과 대조해 정정\"></textarea></div>\n                <div class=\"checks\">\n                  <label class=\"check\"><input id=\"reviewed\" type=\"checkbox\" required><span>자료가 모두 같은 물건인지 대조했고 금액·날짜·사건번호를 확인했습니다. <b>필수</b></span></label>\n                  <label id=\"resultCorrectionPanel\" class=\"check\" hidden><input id=\"resultVisibilityCorrected\" type=\"checkbox\"><span>AI가 결과를 잘못 읽었고 원본에는 낙찰 결과가 없음을 확인했습니다. 수정 이유도 남깁니다.</span></label>\n                  <label class=\"check\"><input id=\"beforeResult\" type=\"checkbox\"><span>이 예측을 작성할 때 매각 결과를 알지 못했습니다. <b>정확도 집계에 필요</b></span></label>\n                  <label class=\"check\"><input id=\"archiveDocuments\" type=\"checkbox\"><span>저장할 때 원본 자료도 내 Google Drive에 보관합니다. 공개 링크를 만들지 않습니다.</span></label>\n                </div>\n                <div class=\"save-footer\"><small>저장 후 원본 예측은 보존됩니다.</small><button id=\"saveButton\" type=\"submit\" class=\"button primary\">확인한 내용 시트에 저장 ↗</button></div>\n              </fieldset>\n            </form>\n            <div id=\"saveMessage\" class=\"message\" role=\"status\" aria-live=\"polite\"></div>\n            <button id=\"newRecordButton\" class=\"button subtle\" type=\"button\" style=\"margin-top:10px\" hidden>다음 물건 기록하기</button>\n          </div>\n        </section>\n      </div>\n      <section class=\"records\" aria-labelledby=\"recordsTitle\">\n        <div class=\"records-heading\"><div><div class=\"eyebrow\">REVIEW & REFLECT</div><h2 id=\"recordsTitle\">쌓이는 기록, 선명해지는 판단</h2></div><div><small id=\"refreshTime\">15초마다 갱신</small> <button id=\"refreshButton\" type=\"button\" class=\"text-button\">새로고침</button></div></div>\n        <div class=\"metrics\">\n          <div class=\"metric\"><span>평가 가능한 회차</span><strong id=\"metricCount\">0<span style=\"display:inline;font-size:12px\"> 건</span></strong></div>\n          <div class=\"metric\"><span>평균 절대 오차율</span><strong id=\"metricAbsolute\">—</strong></div>\n          <div class=\"metric\"><span>평균 예측 오차율</span><strong id=\"metricSigned\">—</strong></div>\n          <div class=\"metric\"><span>오차 5% 이내 비율</span><strong id=\"metricWithin\">—</strong></div>\n        </div>\n        <div class=\"table-wrap\"><table><caption class=\"sr-only\">최근 물건 기록 50건</caption><thead><tr><th>물건 / 회차</th><th>매각기일</th><th>예상 낙찰가</th><th>가상 입찰가</th><th>실제 낙찰가</th><th>예측 오차</th><th>결과</th><th>복기</th></tr></thead><tbody id=\"recordsBody\"><tr><td colspan=\"8\" class=\"empty\">연결 후 기록을 불러옵니다.</td></tr></tbody></table></div>\n        <p class=\"table-note\">최근 50건 표시 · 요약은 전체 기록 기준 · 평균 절대 오차율로 정확도를 확인하세요. 가상 입찰가의 낙찰가 초과 여부와 수익성은 별도 판단입니다.</p>\n      </section>\n    </main>\n    <footer class=\"footer\">MADANG &nbsp; / &nbsp; 사전 예측을 쌓고 결과로 복기하는 나만의 경매 기록장</footer>\n  </div>\n  <dialog id=\"resultDialog\"><h2>결과 기록 · 복기</h2><p id=\"resultProperty\" class=\"hint\"></p><div id=\"resultComparisons\" class=\"hint\" style=\"padding:10px;background:#f1f6e9;border-radius:8px\"></div><div id=\"resultSources\" class=\"hint\"></div><form id=\"resultForm\"><div id=\"updateFields\" class=\"field-grid\"></div><p class=\"hint\">기존 예상 낙찰가·가상 입찰가는 유지하고, 변경 전후 값은 이력에 남깁니다.</p><div id=\"resultMessage\" class=\"message\" aria-live=\"polite\"></div><div class=\"actions\"><button id=\"cancelResult\" type=\"button\" class=\"button\">닫기</button><button id=\"updateResultButton\" type=\"submit\" class=\"button primary\">결과 저장</button></div></form></dialog>\n  <dialog id=\"imageDialog\" class=\"image-dialog\"><button id=\"closeImage\" class=\"button\" type=\"button\" style=\"margin-bottom:10px\">닫기</button><img id=\"largeImage\" alt=\"원본 캡처 확대\"></dialog>\n  <script>\n    'use strict';\n    const $=id=>document.getElementById(id);\n    const state={app:null,documents:[],activeDocument:0,draftId:null,extracted:{},confidence:{},busy:false,saved:false,selectedRecord:null,refreshing:false,verification:null};\n    const documentTypes=['기본정보 캡처','매각물건명세서','등기부등본','감정평가서','현황조사서','기타'];\n    const fields=[\n      ['court','법원','text','fact',true],['caseNumber','사건번호','text','fact',true],['itemNumber','물건번호','text','fact',true],['auctionDate','매각기일','date','fact',true],['address','주소','text','fact',false,'full'],['appraisal','감정가 (원)','money','fact'],['minimumPrice','최저가 (원)','money','fact'],\n      ['forecastDate','예상 작성일','date','forecast'],['predictedPrice','예상 낙찰가 (시장 예측 · 원)','money','forecast'],['virtualBid','가상 입찰가 (내 모의 입찰 · 원)','money','forecast'],['rationale','판단 근거·특징','textarea','forecast',false,'full'],\n      ['marketPrice','예상 시세 (원)','money','cost'],['extraCosts','추가 비용 합계 (원)','money','cost'],['targetProfit','목표 이익 (원)','money','cost'],\n      ['propertyType','유형','property','extra'],['area','면적 (㎡)','decimal','extra'],['failedAuctions','유찰 횟수','integer','extra'],['memoUrl','상세 메모 링크','url','extra',false,'full'],['sourceUrl','물건 출처 링크','url','extra',false,'full'],['reviewNote','복기 메모','textarea','extra',false,'full'],\n      ['saleResult','매각 결과','result','result'],['actualPrice','실제 낙찰가 (원)','money','result'],['bidderCount','입찰자 수','integer','result']\n    ];\n    function createField(spec,prefix=''){\n      const [key,label,type,,required,full]=spec,box=document.createElement('div');box.className='field'+(full?' full':'');box.dataset.key=key;\n      const l=document.createElement('label');l.htmlFor=prefix+key;l.textContent=label+(required?' *':'');box.append(l);\n      const input=document.createElement(type==='textarea'?'textarea':(['property','result'].includes(type)?'select':'input'));input.id=prefix+key;input.name=key;input.required=!!required;\n      if(input.tagName==='INPUT'){input.type=['date','url'].includes(type)?type:'text';if(['money','decimal','integer'].includes(type))input.inputMode='decimal';}\n      if(type==='property'||type==='result'){\n        const options=type==='property'?['','아파트','다세대','단독주택','오피스텔','상가','토지','기타']:['미확인','낙찰','유찰','변경','연기','취하','기각'];\n        options.forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v||'선택';input.append(o);});\n      }\n      if(type==='money')input.placeholder='예: 250,000,000';if(key==='caseNumber')input.placeholder='예: 2026타경1234';if(key==='itemNumber')input.placeholder='예: 1';\n      box.append(input);const note=document.createElement('div');note.className='evidence';box.append(note);\n      if(!prefix)input.addEventListener('input',()=>{updateEvidence(key);updateLimit();updateResultCorrection();$('reviewed').checked=false;});return box;\n    }\n    fields.forEach(spec=>$(spec[3]+'Fields').append(createField(spec)));\n    const updateSpecs=fields.filter(s=>['saleResult','actualPrice','bidderCount','reviewNote'].includes(s[0]));updateSpecs.forEach(spec=>$('updateFields').append(createField(spec,'update_')));\n    function rpc(name,...args){return new Promise((resolve,reject)=>{if(!window.google||!google.script||!google.script.run){reject(new Error('Google 스프레드시트의 마당 기록장 메뉴 또는 배포한 웹앱에서 열어 주세요.'));return;}google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(new Error(e.message||String(e))))[name](...args);});}\n    function message(id,text,isError=false){$(id).textContent=text;$(id).className='message '+(isError?'error':'success');}\n    function today(){return new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());}\n    function setBusy(value){state.busy=value;const locked=value||state.saved;$('recordForm').disabled=locked;$('extractButton').disabled=locked||!state.documents.length||!state.app?.apiKeyConfigured;$('dropzone').disabled=locked;$('addDocuments').disabled=locked||state.documents.length>=3;$('manualButton').disabled=locked;$('fileInput').disabled=locked;$('setupButton').disabled=value;['storeApiKey','checkSetup','checkApi','liveSample','simulatedCheck','verifyRegisteredKey','copyVerification','apiKeyInput'].forEach(id=>$(id).disabled=value);document.querySelectorAll('.document-remove,.document-type').forEach(el=>el.disabled=locked);}\n    function money(value){return value==null||value===''?'—':new Intl.NumberFormat('ko-KR').format(Number(value))+'원';}\n    function pct(value){return value==null||value===''?'—':(Number(value)*100).toFixed(1)+'%';}\n    function safeLink(anchor,url){try{const parsed=new URL(url);if(parsed.protocol!=='https:'&&parsed.protocol!=='http:')return;anchor.href=parsed.href;anchor.hidden=false;}catch{}}\n    function inputValues(){const values={};fields.forEach(([key])=>values[key]=$(key).value.trim());return values;}\n    function setInputValue(key,value){const input=$(key);if(key==='propertyType'&&value&&!Array.from(input.options).some(o=>o.value===String(value))){const option=document.createElement('option');option.value=String(value);option.textContent=String(value);input.append(option);}input.value=value==null?'':String(value);if(key==='saleResult'&&!input.value)input.value='미확인';}\n    function fillForm(values){fields.forEach(([key])=>{setInputValue(key,values[key]);updateEvidence(key);});updateLimit();updateResultCorrection();}\n    function updateEvidence(key){const input=$(key),box=input.closest('.field'),note=box.querySelector('.evidence'),raw=state.extracted[key];box.classList.remove('needs-review');note.textContent='';note.classList.remove('edited');\n      if(raw!==undefined&&String(raw??'')!==input.value){note.textContent='수정됨 · AI 원본: '+(raw==null?'읽지 못함':String(raw));note.classList.add('edited');return;}\n      const conf=state.confidence[key],score=typeof conf==='number'?conf:conf?.confidence??conf?.score;const evidence=typeof conf==='object'?conf?.evidence:'';\n      if(raw===null||(score!=null&&Number(score)<.8)||['medium','low','unknown'].includes(conf)){box.classList.add('needs-review');note.textContent=(evidence?'원문: '+String(evidence)+' · ':'')+'원본 확인 필요';}\n    }\n    function updateResultCorrection(){const raw=state.extracted;const rawKnown=raw.saleResult==='낙찰'||(raw.actualPrice!=null&&String(raw.actualPrice).trim()!==''&&String(raw.actualPrice).trim()!=='0');const currentUnknown=$('saleResult').value==='미확인'&&$('actualPrice').value.trim()==='';const eligible=rawKnown&&currentUnknown;$('resultCorrectionPanel').hidden=!eligible;if(!eligible)$('resultVisibilityCorrected').checked=false;$('correctionReason').required=eligible&&$('resultVisibilityCorrected').checked;}\n    function updateLimit(){const values=['marketPrice','extraCosts','targetProfit'].map(k=>$(k).value.trim());if(values.some(v=>v==='')){$('upperLimit').textContent='—';return;}const nums=values.map(v=>Number(v.replaceAll(',','')));$('upperLimit').textContent=nums.every(Number.isFinite)?money(nums[0]-nums[1]-nums[2]):'저장 시 금액 확인';}\n    async function loadState(silent=false){if(state.refreshing)return;state.refreshing=true;try{const data=await rpc('getAppState');state.app=data;$('setupNotice').hidden=!!data.configured;$('keyNotice').hidden=!!data.apiKeyConfigured;$('setupStatus').textContent=(data.configured?'시트 준비됨':'시트 준비 필요')+' · '+(data.apiKeyConfigured?'API 키 저장됨 (연결은 별도 점검)':'API 키 미등록');$('connection').textContent=data.configured?'Google Sheets 연결됨':'시트 준비 필요';$('connection').className='connection '+(data.configured?'ok':'');if(data.sheetUrl||data.spreadsheetUrl)safeLink($('sheetLink'),data.sheetUrl||data.spreadsheetUrl);renderRecords(data.records||[]);renderMetrics(data.metrics||{});$('refreshTime').textContent=new Intl.DateTimeFormat('ko-KR',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'Asia/Seoul'}).format(new Date())+' 갱신 · 15초 간격';setBusy(state.busy);}catch(e){$('connection').textContent='연결 확인 필요';$('connection').className='connection error';if(!silent)message('saveMessage',e.message,true);}finally{state.refreshing=false;}}\n    function renderMetrics(m){$('metricCount').textContent=(m.evaluableCount||0)+' 건';$('metricAbsolute').textContent=pct(m.meanAbsoluteError);$('metricSigned').textContent=pct(m.meanPredictionError);$('metricWithin').textContent=pct(m.withinFivePercentRatio);$('metricWithin').title=(m.withinFivePercentCount||0)+'건 / '+(m.evaluableCount||0)+'건';}\n    function renderRecords(records){const body=$('recordsBody');body.replaceChildren();if(!records.length){const row=body.insertRow(),cell=row.insertCell();cell.colSpan=8;cell.className='empty';cell.textContent='아직 기록이 없습니다. 첫 물건의 사전 예측을 남겨 보세요.';return;}records.forEach(rec=>{const tr=body.insertRow();let td=tr.insertCell();td.textContent=rec.address||rec.caseNumber;const small=document.createElement('small');small.textContent=[rec.court,rec.caseNumber,'물건 '+rec.itemNumber].join(' · ');td.append(small);[rec.auctionDate,money(rec.predictedPrice),money(rec.virtualBid),money(rec.actualPrice),rec.evaluable?pct(rec.predictionError):'평가 제외',rec.saleResult||'미확인'].forEach(v=>{const cell=tr.insertCell();cell.textContent=v;});const b=document.createElement('button');b.className='text-button';b.type='button';b.textContent='결과·복기';b.addEventListener('click',()=>openResult(rec));tr.insertCell().append(b);});}\n    function invalidateExtraction(){state.draftId=null;state.extracted={};state.confidence={};$('reviewed').checked=false;$('beforeResult').checked=false;$('extractionWarnings').hidden=true;updateResultCorrection();fields.forEach(([key])=>updateEvidence(key));$('reviewTag').textContent='자료 확인 후 다시 읽기';}\n    function releaseDocument(doc){if(doc?.objectUrl)URL.revokeObjectURL(doc.objectUrl);}\n    function resetRecord(){state.documents.forEach(releaseDocument);state.documents=[];state.activeDocument=0;state.draftId=null;state.extracted={};state.confidence={};state.saved=false;$('journalForm').reset();fillForm({forecastDate:today(),saleResult:'미확인'});$('documentList').replaceChildren();$('previewPanel').hidden=true;$('dropzone').hidden=false;$('previewImage').removeAttribute('src');$('largeImage').removeAttribute('src');$('pdfLink').removeAttribute('href');$('imageTag').textContent='원본부터 차근차근';$('reviewTag').textContent='수동 입력 가능';$('newRecordButton').hidden=true;$('extractionWarnings').hidden=true;$('fileInput').value='';message('saveMessage','');message('sourceMessage','');setBusy(false);}\n    function renderDocuments(){const list=$('documentList');list.replaceChildren();state.documents.forEach((doc,index)=>{const item=document.createElement('div');item.className='document-item'+(index===state.activeDocument?' active':'');const top=document.createElement('div');top.className='document-top';const name=document.createElement('button');name.type='button';name.className='document-name';const strong=document.createElement('strong');strong.textContent=doc.name;const small=document.createElement('small');small.textContent=(doc.mimeType==='application/pdf'?'PDF':'이미지')+' · '+Math.ceil(doc.size/1024)+'KB';name.append(strong,small);name.addEventListener('click',()=>{state.activeDocument=index;renderDocuments();});const remove=document.createElement('button');remove.type='button';remove.className='document-remove';remove.textContent='삭제';remove.setAttribute('aria-label',doc.name+' 삭제');remove.addEventListener('click',()=>{if(state.busy||state.saved)return;releaseDocument(doc);state.documents.splice(index,1);state.activeDocument=Math.min(state.activeDocument,Math.max(0,state.documents.length-1));invalidateExtraction();renderDocuments();message('sourceMessage','자료 목록이 변경되었습니다. AI로 다시 읽거나 내용을 직접 확인해 주세요.');});top.append(name,remove);const type=document.createElement('select');type.className='document-type';type.setAttribute('aria-label',doc.name+' 자료 종류');documentTypes.forEach(label=>{const option=document.createElement('option');option.value=label;option.textContent=label;type.append(option);});type.value=doc.documentType;type.addEventListener('change',()=>{doc.documentType=type.value;invalidateExtraction();});item.append(top,type);list.append(item);});\n      const doc=state.documents[state.activeDocument];$('previewPanel').hidden=!doc;$('dropzone').hidden=!!doc;$('imageTag').textContent=doc?state.documents.length+'개 자료 · 같은 물건':'원본부터 차근차근';if(doc){const isPdf=doc.mimeType==='application/pdf';$('previewButton').hidden=isPdf;$('pdfPreview').hidden=